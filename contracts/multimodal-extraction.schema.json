{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/VietCT04/VideoGraph/contracts/multimodal-extraction.schema.json",
  "title": "VideoGraph multimodal extraction payload",
  "description": "Content-local candidate facts. Local IDs never become persistent graph IDs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_id", "creator_id", "moments"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "content_id": {"type": "string", "minLength": 1},
    "creator_id": {"type": "string", "minLength": 1},
    "content_metadata": {"$ref": "#/$defs/contentMetadata"},
    "pipeline": {"$ref": "#/$defs/pipelineMetadata"},
    "moments": {"type": "array", "items": {"$ref": "#/$defs/moment"}}
  },
  "$defs": {
    "contentMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string"},
        "source_type": {"enum": ["live", "video"]},
        "duration_ms": {"type": "integer", "minimum": 0},
        "language": {"type": "string"}
      }
    },
    "pipelineMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "asr_model": {"type": "string"},
        "vision_model": {"type": "string"},
        "embedding_model": {"type": "string"}
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_id", "type", "name", "confidence"],
      "properties": {
        "local_id": {"type": "string", "minLength": 1},
        "type": {"enum": ["Content", "Event", "Organization", "Person", "Place", "Product", "Technology", "Topic"]},
        "name": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "explicit": {"type": "boolean"}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "predicate", "object", "confidence", "evidence_refs"],
      "properties": {
        "subject": {"type": "string", "minLength": 1},
        "predicate": {"enum": ["ABOUT", "APPEARS_IN", "COMPARES", "CREATED_BY", "DISLIKES", "LOCATED_IN", "LIKES", "MENTIONS", "OWNS", "PART_OF", "PREFERS_OVER", "RECOMMENDS", "SWITCHED_TO", "USES", "VISITS", "WEARS"]},
        "object": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "explicit": {"type": "boolean"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asr_segment_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "frame_timestamps_ms": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "frame_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "ocr_text": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "ocr_item_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "embedding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "dimension", "vector"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "dimension": {"type": "integer", "minimum": 1},
        "vector": {"type": "array", "items": {"type": "number"}},
        "normalized": {"type": "boolean"}
      }
    },
    "moment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_id", "start_ms", "end_ms", "semantic_text", "entities", "relations", "evidence"],
      "properties": {
        "local_id": {"type": "string", "minLength": 1},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 0},
        "transcript": {"type": "string"},
        "semantic_text": {"type": "string", "minLength": 1},
        "entities": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
        "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
        "evidence": {"$ref": "#/$defs/evidence"},
        "embedding": {"anyOf": [{"$ref": "#/$defs/embedding"}, {"type": "null"}]}
      }
    }
  }
}
