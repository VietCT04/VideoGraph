# VideoGraph local development configuration

# HTTP ports
FRONTEND_PORT=3000
BACKEND_PORT=8000
AI_SERVICE_PORT=8001
POSTGRES_PORT=5432
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
COMPOSE_PROJECT_NAME=videograph

# Backend-to-service endpoint
AI_SERVICE_URL=http://localhost:8001

# Local persistence endpoints (credentials belong in an untracked .env file)
POSTGRES_URL=postgresql://videograph:change-me@localhost:5432/videograph
POSTGRES_DB=videograph
POSTGRES_USER=videograph
POSTGRES_PASSWORD=change-me
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
FRONTEND_BACKEND_URL=http://localhost:8000
AI_SERVICE_TOKEN=

# Optional provider configuration is intentionally not committed.
# ASR_MODEL=
# VLM_MODEL=
# EMBEDDING_MODEL=
